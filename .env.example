# Copy to .env on the server. Never commit the real .env file.

# Public OIDC parameters returned before login.
LIFE_HUB_OIDC_CLIENT_ID="replace-with-authentik-client-id"
LIFE_HUB_OIDC_AUTHORIZE_URL="https://login.example.com/application/o/authorize/"
LIFE_HUB_OIDC_TOKEN_URL="https://login.example.com/application/o/token/"

# Server-only Authentik validation endpoint.
LIFE_HUB_OIDC_USERINFO_URL="https://login.example.com/application/o/userinfo/"

# Authentik group names are matched case-insensitively against the UserInfo groups claim.
# Create this group in Authentik and add dashboard administrators to it.
LIFE_HUB_ADMIN_GROUPS="Life Dashboard Admins"
LIFE_HUB_ADMIN_USERS=""
LIFE_HUB_ADMIN_EMAILS=""

# Returned only after Authentik verifies an administrator account.
LIFE_HUB_HA_URL="https://home.example.com"
LIFE_HUB_HA_TOKEN="replace-with-home-assistant-long-lived-token"

# Optional local browser login. This can enter the dashboard but cannot unlock HA secrets.
LIFE_HUB_LOCAL_AUTH_USERNAME="admin"
LIFE_HUB_LOCAL_AUTH_SALT="base64-salt"
LIFE_HUB_LOCAL_AUTH_HASH="base64-pbkdf2-hash"
LIFE_HUB_LOCAL_AUTH_ITERATIONS="310000"

# One-click updater reuses the Authentik administrator session; no update token is needed.
LIFE_HUB_UPDATE_BRANCH="main"
LIFE_HUB_UPDATE_REPOSITORY="https://github.com/Guyao146/Life-Dashboard.git"
